#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <3>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
            layers = <0>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
            layers = <0>;
        };

        bikkuri {
            bindings = <&kp EXCLAMATION>;
            key-positions = <18 19>;
            layers = <0>;
        };

        MouseButton2 {
            bindings = <&mkp MB2>;
            key-positions = <13 12>;
            layers = <1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q               &kp W             &kp E         &kp R               &kp T                                                   &kp Y         &kp U  &kp I      &kp O    &kp P
&mt LEFT_CONTROL A  &kp S             &kp D         &kp F               &kp G      &kp LG(LS(KP_NUMBER_4))      &kp MINUS       &kp H         &kp J  &kp K      &kp L    &kp ENTER
&mt LEFT_SHIFT Z    &kp X             &kp C         &kp V               &kp B      &kp SEMICOLON                &kp APOSTROPHE  &kp N         &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_SHIFT      &kp LEFT_CONTROL  &kp LEFT_ALT  &mt LEFT_GUI LANG2  &kp SPACE  &lt 1 LANGUAGE_1             &kp BACKSPACE   &lt 2 RETURN                             &lt 3 TAB
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        NUM {
            bindings = <
&kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                                                     &kp NUMBER_6           &kp NUMBER_7      &kp NUMBER_8       &kp NUMBER_9     &kp NUMBER_0
&kp GRAVE       &trans        &mkp MB1      &mkp MB1      &trans        &kp LC(LA(KP_NUMBER_0))      &kp MINUS             &kp EQUAL              &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp EXCLAMATION  &kp AT_SIGN
&kp LEFT_SHIFT  &trans        &trans        &trans        &trans        &trans                       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans           &kp BACKSLASH
&kp LEFT_SHIFT  &trans        &trans        &trans        &trans        &trans                       &trans                &trans                                                                       &kp PIPE
            >;
        };

        ARROW,Fn {
            bindings = <
&kp ESCAPE      &kp F1  &kp F2   &kp F3   &kp F4                              &trans    &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans
&trans          &kp F5  &kp F6   &kp F7   &kp F8   &kp LG(LC(Q))      &trans  &kp HOME  &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END
&kp LEFT_SHIFT  &kp F9  &kp F10  &kp F11  &kp F12  &trans             &kp F1  &kp F2    &kp LG(LS(LEFT_ARROW))  &kp F3          &kp LG(LS(RIGHT_ARROW))  &kp F12
&kp LEFT_SHIFT  &trans  &trans   &trans   &kp F4   &trans             &trans  &trans                                                                     &kp F11
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        BT {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
